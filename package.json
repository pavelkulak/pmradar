{
  "name": "pm-chat-inbox",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "setup:telegram": "node --env-file-if-exists=.env scripts/setup-telegram.mjs",
    "setup:max": "node --env-file-if-exists=.env scripts/setup-max.mjs",
    "check:max": "node --env-file-if-exists=.env scripts/check-max.mjs",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "json-bigint": "^1.0.0",
    "next": "^16.2.0",
    "prisma": "^6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
